# Copy to .env.local and fill in your values.
# .env.local is gitignored.
#
# Two operating modes:
#   1. Mock mode (default for dev/test):
#        USE_MOCK_GOOGLE=true
#        USE_MOCK_PUBLISHERS=true
#      → GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET can stay blank. The API
#        returns synthetic OAuth flows; the worker uses stub publishers.
#      → Safe for fresh checkouts, the simulator, and CI.
#
#   2. Real mode (publishing to a real YouTube channel):
#        USE_MOCK_GOOGLE=false
#        USE_MOCK_PUBLISHERS=false
#      → All GOOGLE_* and TOKEN_ENCRYPTION_KEY values required. See
#        plans/core/phase-0-bootstrap/google-cloud-setup.md for the full
#        Google Cloud Console walkthrough.
#
# The API and worker will refuse to start in real mode without these vars.

# === API ===
API_PORT=3000
API_HOST=0.0.0.0
WEB_ORIGIN=http://localhost:5173

# === Database ===
DATABASE_URL=file:./storage/app.db

# === Storage ===
STORAGE_DIR=./storage
STORAGE_QUOTA_GB=10
MAX_VIDEO_SIZE_GB=2

# === Google OAuth (YouTube Data API v3) ===
# Get these from https://console.cloud.google.com/apis/credentials
# In mock mode these can stay blank; the API rejects blank values when
# USE_MOCK_GOOGLE=false.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must exactly match one of the Authorized redirect URIs in Google Cloud
# Console for the OAuth client. Default is the local dev port.
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/callback

# === YouTube API key (for testing/quota queries only) ===
YOUTUBE_API_KEY=

# === Encryption key for OAuth tokens at rest (32 bytes hex = 64 chars) ===
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Required in both mock and real mode. Treat as a secret; rotate by
# re-authorizing every account (existing encrypted tokens become invalid).
TOKEN_ENCRYPTION_KEY=

# === Mock mode flags ===
# When true, the API uses mock OAuth clients + the worker uses stub
# publishers — full end-to-end flow without real credentials.
USE_MOCK_GOOGLE=true
USE_MOCK_PUBLISHERS=true

# === Mock-only TikTok / Meta flags (Phase 2) ===
USE_MOCK_TIKTOK=true
USE_MOCK_META=true

# === Real TikTok (Phase 2 — requires TikTok partner review) ===
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=http://localhost:3000/auth/tiktok/callback

# === Real Meta / Facebook / Instagram (Phase 2 — requires Meta app review) ===
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=http://localhost:3000/auth/meta/callback
META_API_VERSION=v24.0

# === Database Backup Configuration ===
BACKUP_DIR=./storage/backups
BACKUP_RETENTION_DAYS=7
BACKUP_COMPRESS=true

# === Worker Configuration ===
POLL_INTERVAL_MS=30000
UPLOAD_CONCURRENCY=3

# === Logging ===
LOG_LEVEL=info

# === Sentry Error Tracking (Optional) ===
# Get DSN from https://sentry.io
SENTRY_DSN=
SENTRY_ENVIRONMENT=production

# === Optional: Off-site Storage (Cloudflare R2, AWS S3, etc.) ===
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_ENDPOINT=
