# Copy to .env.local and fill in your values.
# .env.local is gitignored.

# === API ===
API_PORT=3000
API_HOST=0.0.0.0
WEB_ORIGIN=http://localhost:5173

# === Database ===
DATABASE_URL=file:./storage/app.db

# === Storage ===
STORAGE_DIR=./storage

# === Google OAuth (YouTube Data API v3) ===
# From https://console.cloud.google.com/apis/credentials (Web application OAuth client).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/callback

# === YouTube API key (for testing/quota queries only) ===
YOUTUBE_API_KEY=

# === Encryption key for OAuth tokens at rest (32 bytes hex) ===
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOKEN_ENCRYPTION_KEY=

# === Test mode ===
# Set USE_MOCK_GOOGLE=false + USE_MOCK_PUBLISHERS=false to talk to real YouTube.
USE_MOCK_GOOGLE=true

# === Worker ===
USE_MOCK_PUBLISHERS=true
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
META_APP_ID=
META_APP_SECRET=

# --- IMPORTANT for real-YouTube mode ---
# 1. OAuth consent screen → Publish App. Without this, refresh tokens expire
#    every 7 days (Testing mode default) and the worker will mark every account
#    as 'expired' within a week.
# 2. The token-encryption key MUST stay stable forever — rotating it
#    invalidates every stored refresh token.
