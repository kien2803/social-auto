# Production deploy — copy to .env next to docker-compose.yml
# Generate secrets: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

TOKEN_ENCRYPTION_KEY=
JWT_SECRET=

# Public origin users reach the app at — OAuth callbacks redirect here.
# MUST match the redirect URIs registered at each platform console.
WEB_ORIGIN=https://app.yourdomain.com

# Real credentials — leave USE_MOCK_* unset/false in production.
USE_MOCK_GOOGLE=false
USE_MOCK_PUBLISHERS=false
USE_MOCK_TIKTOK=false
USE_MOCK_META=false

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://app.yourdomain.com/auth/callback

TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=https://app.yourdomain.com/auth/tiktok/callback

META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=https://app.yourdomain.com/auth/meta/callback
META_API_VERSION=v24.0

NODE_ENV=production
SECURE_COOKIES=true
LOG_LEVEL=info
STORAGE_QUOTA_GB=10
# SENTRY_DSN=
